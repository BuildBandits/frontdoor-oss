# Server
PORT=3001
NODE_ENV=development
DATABASE_PATH=./frontdoor.db

# Domain (without protocol)
BASE_DOMAIN=frontdoor.local
FRONTEND_URL=http://frontdoor.local:5173

# Azure AD
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://frontdoor.local:3001/api/auth/microsoft/callback

# JWT
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# Admin emails (comma-separated, auto-promoted on startup)
ADMIN_EMAILS=

# API key for bulk endpoints (CLI/automation)
ADMIN_API_KEY=
