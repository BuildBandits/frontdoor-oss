# .env.example.docker — Deployment with docker-compose.yml
# Copy to .env and fill in your Azure AD credentials and a unique JWT_SECRET
# (at least 32 characters). For a local demo without Azure, use
# docker-compose.demo.yml instead (see README).

# Server
PORT=3001
NODE_ENV=production
DATABASE_PATH=/data/frontdoor.db
AVATAR_CACHE_DIR=/data/avatar-cache
BRANDING_ASSET_DIR=/data/branding
APP_ICON_CACHE_DIR=/data/app-icon-cache
PLUGIN_ASSET_DIR=/data/plugins
AVATAR_CACHE_TTL_DAYS=14
AVATAR_CACHE_MISS_TTL_DAYS=30

# Domain (without protocol). Use your public root domain in production.
BASE_DOMAIN=localhost
# In Docker, Express serves both API and frontend on the same port.
FRONTEND_URL=http://localhost:3001
# Comma-separated list of origins allowed to make credentialed cross-origin requests (e.g. for shared-cookie satellite apps). Leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=

# Dev login — bypass Microsoft SSO with a local dev user.
# Has no effect in Docker because NODE_ENV=production.
# DEV_LOGIN=false

# Azure AD (see README for setup instructions)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback

# JWT
JWT_SECRET=change-this-in-production
ENTRA_GROUP_SYNC=true
JWT_EXPIRES_IN=7d

# Admin emails (comma-separated, auto-promoted on login)
ADMIN_EMAILS=

# API key for bulk endpoints (CLI/automation)
ADMIN_API_KEY=
