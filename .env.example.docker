# .env.example.docker — Local Frontdoor demo with Docker Compose
# Copy to .env and run `docker compose up --build`.
# This profile is intentionally local-only and enables Dev Login without Azure.

# Server
PORT=3001
NODE_ENV=development
DEV_LOGIN=true
# Keep the role-selectable Dev Login reachable only from this machine.
FRONTDOOR_BIND_ADDRESS=127.0.0.1
DATABASE_PATH=/data/frontdoor.db
AVATAR_CACHE_DIR=/data/avatar-cache
BRANDING_ASSET_DIR=/data/branding
AVATAR_CACHE_TTL_DAYS=14
AVATAR_CACHE_MISS_TTL_DAYS=30

# Domain (without protocol). Use your public root domain in production.
BASE_DOMAIN=localhost
# In Docker, Express serves both API and frontend on the same port.
FRONTEND_URL=http://localhost:3001
# Comma-separated list of origins allowed to make credentialed cross-origin requests (e.g. for shared-cookie satellite apps). Leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=

# Azure AD is optional for this local demo (see README for production setup).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback

# JWT — left empty so local Dev Login uses the built-in development fallback.
# Production requires a unique secret with at least 32 characters.
JWT_SECRET=
ENTRA_GROUP_SYNC=false
JWT_EXPIRES_IN=7d

# Admin emails (comma-separated, auto-promoted on login)
ADMIN_EMAILS=

# API key for bulk endpoints (CLI/automation)
ADMIN_API_KEY=
