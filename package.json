    "auth",
    "gateway",
    "sso",
    "microsoft",
    "azure-ad",
    "app-catalog",
    "rbac"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "nodemon": "^3.0.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.1",
    "vite": "^8.1.6"
  }
