{
  "name": "oss-frontdoor",
  "version": "1.2.8d",
  "description": "Authentication gateway and app catalog for self-hosted projects",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"nodemon server/index.js\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "start": "node server/index.js",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node --import ./test/setup.js --test test/*.test.js",
    "db:seed": "node server/seed.js",
    "avatars:prewarm": "node server/scripts/prewarmAvatars.js"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dompurify": "^3.4.16",
    "dotenv": "^16.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsdom": "^24.1.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.323.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.18.4",
    "uuid": "^11.1.1",
    "zustand": "^4.5.0"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "form-data": "^4.0.6",
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
