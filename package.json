{
  "name": "oss-frontdoor",
  "version": "1.3.0",
  "description": "Self-hosted authentication gateway and app catalog with Microsoft Entra ID SSO, RBAC and per-group app visibility",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"node --watch-path=server --watch-path=shared server/index.js\"",
    "dev:server": "node --watch-path=server --watch-path=shared server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "start": "node server/index.js",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node --import ./test/setup.js --test test/*.test.js",
    "db:seed": "node server/seed.js",
    "avatars:prewarm": "node server/scripts/prewarmAvatars.js",
    "backup:decrypt": "node scripts/backup-decrypt.mjs",
    "backup:rehearse": "node scripts/backup-rehearse.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsdom": "^30.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uuid": "^11.1.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "form-data": "^4.0.6",
    "qs": "^6.16.0",
    "shell-quote": "^1.12.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuildBandits/frontdoor-oss.git"
  },
  "homepage": "https://frontdoor.buildbandits.com",
  "bugs": {
    "url": "https://github.com/BuildBandits/frontdoor-oss/issues"
  },
  "keywords": [
    "authentication",
    "sso",
    "single-sign-on",
    "app-catalog",
    "gateway",
    "microsoft-entra-id",
    "azure-ad",
    "rbac",
    "self-hosted"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.6"
  }
}
