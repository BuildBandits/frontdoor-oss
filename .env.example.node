# .env.example.node — Local development with npm run dev (Vite + Express)
# Copy to .env and fill in your Azure AD credentials.

# Server
PORT=3001
NODE_ENV=development
DATABASE_PATH=./frontdoor.db
AVATAR_CACHE_DIR=./data/avatar-cache
BRANDING_ASSET_DIR=./data/branding
AVATAR_CACHE_TTL_DAYS=14
AVATAR_CACHE_MISS_TTL_DAYS=30

# Domain (without protocol)
BASE_DOMAIN=localhost
# In dev mode, Vite serves the frontend on port 5173.
FRONTEND_URL=http://localhost:5173
# Comma-separated list of origins allowed to make credentialed cross-origin requests (e.g. for shared-cookie satellite apps). Leave empty to disable CORS.
CORS_ALLOWED_ORIGINS=

# Dev login — bypass Microsoft SSO with a local dev user.
# Set to true to enable (ignored when NODE_ENV=production).
# When enabled, Azure AD credentials below are optional.
DEV_LOGIN=true

# Azure AD (see README for setup instructions)
# Not required when DEV_LOGIN=true.
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback

# JWT
JWT_SECRET=change-this-in-production
ENTRA_GROUP_SYNC=false
# Minutes between tenant-wide group catalog refreshes triggered by sign-ins (force sync always refreshes)
ENTRA_TENANT_REFRESH_MINUTES=360
# Days a resolved admin notification is kept (default 30)
# NOTIFICATION_RETENTION_DAYS=30
JWT_EXPIRES_IN=7d

# Admin emails (comma-separated, auto-promoted on login)
ADMIN_EMAILS=

# API key for bulk endpoints (CLI/automation)
ADMIN_API_KEY=
